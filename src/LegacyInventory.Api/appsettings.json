{
  "ConnectionStrings": {
    "InventoryDb": "Data Source=localhost;Initial Catalog=Inventory;User ID=inventory_app;Password=${INVENTORY_DB_PASSWORD}"
  },
  "Cache": {
    "Minutes": 10
  },
  "PriceFeed": {
    "BaseUrl": "http://pricefeed.contoso.local/api"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
